# API base URL (include trailing slash). Used by the server proxy. Falls back to production if unset.
# Prefer API_URL so the browser does not need the upstream host. NEXT_PUBLIC_API_URL still works.
API_URL=https://api.investwithyanci.com/v1/

# Required in production. Signs the user cookie. At least 32 characters. Never commit a real value.
SESSION_SECRET=
